# Copy to .env and adjust. Never commit .env.
# Never put gallery cookies (ipb_member_id / ipb_pass_hash / igneous) here —
# Sign In through the app UI; cookies stay in the browser.
# Docker: load ehentai-view:revive then `docker compose up -d` (no --build on Windows).
# Details: DOCKER.md and README.md § Docker & environment.

# Upstream site default when the client does not send X-EHV-Site / ehv_site.
# Prefer Settings → Gallery site in the app (runtime). e-hentai = public; exhentai needs Sign-In.
# Compose + app default if unset: e-hentai.
EHV_SITE=e-hentai

# Optional proxy for server→site requests, e.g. http://host.docker.internal:7890
# EHV_PROXY=

# FlareSolverr /v1 for optional password Sign In (often fails Turnstile; prefer Browser login + cookie paste).
# Default in docker-compose.yml: http://flaresolverr:8191/v1 (same compose network).
# EHV_FLARESOLVERR_URL=http://flaresolverr:8191/v1
# External solver on the Docker host (Windows): http://host.docker.internal:8191/v1
# Leave unset only if you override compose. Browser login (paste cookies) does not need FlareSolverr.

# --- Port (change the listen/browser port in .env) ---
# Docker Compose: host/browser port → container 8080. If 3000 is taken, set e.g. 3001
#   then open http://localhost:3001  (restart: docker compose up -d)
EHV_HOST_PORT=3000
#
# Bare Node / start.bat / dev.bat: Node listens on PORT (browser hits that port).
#   Default 3000. If PORT is unset, EHV_HOST_PORT above is used as an alias.
#   Examples:
#     PORT=3001
#     set PORT=3001 && start.bat
#   (Compose always sets container PORT=8080; do not rely on PORT for Docker host mapping.)
# PORT=3000

# Optional User-Agent override for upstream fetches
# EHV_USER_AGENT=

# Advanced (usually leave unset): image-proxy timeout in ms (default 10000)
# EHV_PROXY_TIMEOUT=

# --- Downloads (offline gallery zips / images) ---
# Bare Node / bats: storage directory (default: ./data/downloads under cwd).
# EHV_DOWNLOADS_DIR=./data/downloads
# Alias (same meaning): EHV_DOWNLOAD_DIR=
#
# Docker Compose: container always uses /app/data/downloads (set in compose).
# Host folder bind-mounted into that path — default ./downloads (compose project dir).
# Examples: EHV_DOWNLOADS_HOST=./downloads   or   EHV_DOWNLOADS_HOST=.
# EHV_DOWNLOADS_HOST=./downloads
#
# EHV_DOWNLOAD_CONCURRENCY=3
# EHV_DOWNLOAD_MAX_PAGES=500
