# Copy to .env and adjust. Never commit .env. Never put gallery cookies here.

# Upstream site: e-hentai (public) or exhentai (requires Sign-In in the browser)
EHV_SITE=e-hentai

# Optional proxy for server→site requests, e.g. http://host.docker.internal:7890
# EHV_PROXY=

# Host port published by docker compose (maps to container 8080)
EHV_HOST_PORT=3000

# Optional User-Agent override for upstream fetches
# EHV_USER_AGENT=
