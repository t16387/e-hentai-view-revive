# syntax=docker/dockerfile:1
# Runtime-only image: expects a host/lab `pnpm build` (.next already present).
# Use when full multi-stage build OOMs (e.g. Windows Docker Desktop).
# Never bake .env / cookies / secrets into the context.
ARG NODE_VERSION=22

FROM node:${NODE_VERSION}-alpine AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NEXT_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /app

FROM base AS prod-deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --prod --ignore-scripts

FROM node:${NODE_VERSION}-alpine AS runtime
ENV NODE_ENV=production PORT=8080 NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY --from=prod-deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node package.json next.config.js next-i18next.config.js ./
COPY --chown=node:node public ./public
COPY --chown=node:node server ./server
COPY --chown=node:node .next ./.next
USER node
EXPOSE 8080
CMD ["node", "server/src/server.js"]
